# Copier ce fichier en `.env` (ou `.env.local`) puis compléter.
# Les variables préfixées VITE_ sont intégrées au bundle (publiques) : n'y mettez aucun secret.

# --- Serveur de la PWA (dev & preview) ---
# Port d'écoute de la PWA (8080 = site actuel, 8081 = websocket du bot)
PWA_PORT=8082
# Backend Go (services/site) vers lequel /api, /img, /video et /download sont proxifiés
BACKEND_URL=http://localhost:8080

# --- Discord ---
# ID de l'application Discord (portail développeur > OAuth2)
VITE_DISCORD_CLIENT_ID=<ID_APPLICATION_DISCORD>
# URL de retour OAuth2 : doit être ajoutée dans le portail Discord (OAuth2 > Redirects)
VITE_DISCORD_REDIRECT_URI=http://localhost:8082/discord
# Lien d'invitation du bot (bouton "Ajouter à Discord" de l'accueil)
VITE_LINK_INVITE_BOT=
