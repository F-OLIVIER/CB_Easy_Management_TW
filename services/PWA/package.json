{
  "name": "easy-management-tw-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Front PWA (Vue 3 + TypeScript) de Easy Management TW",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "icons": "python3 scripts/generate-icons.py",
    "test:e2e": "bash e2e/docker/run.sh",
    "test:e2e:report": "playwright show-report e2e/.work/report"
  },
  "dependencies": {
    "@fontsource/agbalumo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "dompurify": "^3.4.16",
    "html2canvas": "^1.4.1",
    "quill": "^2.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^3.3.13"
  }
}
