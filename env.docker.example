# Variables de docker-compose.yml : copier ce fichier en `.env` à la racine du projet.

# --- Utilisateur des conteneurs ---
# UID/GID propriétaire de services/database, des images et des logs sur l'hôte (commande : id)
APP_UID=1000
APP_GID=1000

# --- Ports ---
# Adresse sur laquelle la PWA (seul service exposé) est publiée :
# 127.0.0.1 = uniquement via Caddy (production) ; 0.0.0.0 = accessible depuis l'extérieur
BIND_ADDRESS=127.0.0.1
# Port de l'API Go, interne au réseau Docker : DOIT être égal à PORT dans services/site/internal/config.go
SITE_PORT=8080
# Port de la PWA sur l'hôte (8081 est réservé au websocket interne du bot)
PWA_PORT=8082

# --- Bot Discord ---
# Fichier contenant TOKEN et ID_APP (ex. ./services/bot/.env.prod en production)
BOT_ENV_FILE=./services/bot/.env

# --- Application Discord ---
# ID de l'application Discord (OBLIGATOIRE). Intégré au build de la PWA (relancer `docker compose up -d --build pwa`
# après modification) et transmis au site (DISCORD_CLIENT_ID) : seuls les jetons de connexion délivrés pour cette
# application sont acceptés. Sans valeur, toute connexion est refusée.
VITE_DISCORD_CLIENT_ID=<ID_APPLICATION_DISCORD>
# URL publique de la PWA + /discord, à déclarer dans le portail Discord (OAuth2 > Redirects).
# En production, passer par HTTPS (ex. Caddy) : cookie "Secure" et service worker l'exigent.
# Production : https://easymanagementtw.freivilo.fr/discord
VITE_DISCORD_REDIRECT_URI=http://localhost:8082/discord
VITE_LINK_INVITE_BOT=
